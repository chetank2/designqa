# DesignQA Environment Configuration (root)
# Copy this file to .env and fill in required values.

# Server Configuration
PORT=3847
NODE_ENV=development

# Figma / MCP Configuration (optional)
# Not required if you are not using the Figma API or MCP integration.
# FIGMA_CONNECTION_MODE=figma
# FIGMA_MCP_URL=https://mcp.figma.com/mcp
# FIGMA_MCP_PORT=3845
# MCP_ENABLED=false
# ENABLE_LOCAL_MCP=false

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3847
CORS_CREDENTIALS=true

# Puppeteer Configuration
PUPPETEER_HEADLESS=new
PUPPETEER_TIMEOUT=30000
PUPPETEER_PROTOCOL_TIMEOUT=60000
# PUPPETEER_EXECUTABLE_PATH=/path/to/Chromium
# PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox

# Comparison Thresholds
COLOR_DIFFERENCE_THRESHOLD=10
SIZE_DIFFERENCE_THRESHOLD=5
SPACING_DIFFERENCE_THRESHOLD=3
FONT_SIZE_DIFFERENCE_THRESHOLD=2

# Timeouts (ms)
FIGMA_EXTRACTION_TIMEOUT=60000
WEB_EXTRACTION_TIMEOUT=30000
COMPARISON_TIMEOUT=10000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_EXTRACTION_MAX=10

# Database (local / SaaS)
DATABASE_URL=file:./data/app.db
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_KEY=your_supabase_service_key

# Frontend Build (Vite)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Deployment Mode (optional)
# DEPLOYMENT_MODE=local|saas
DB_MODE=local

# HTTPS (optional, recommended for desktop bridge from web)
# HTTPS_PORT=3848
# HTTPS_KEY_PATH=/path/to/localhost-key.pem
# HTTPS_CERT_PATH=/path/to/localhost.pem
# HTTPS_CA_PATH=/path/to/localhost-ca.pem

# Credential Encryption (optional but recommended)
# CREDENTIAL_ENCRYPTION_KEY=base64_32_bytes
# LOCAL_CREDENTIAL_KEY=hex_32_bytes

# Chrome Extension Backend (optional)
# EXTENSION_BACKEND_URL=http://localhost:3847
