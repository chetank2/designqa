# Frontend Environment Configuration

# API URL for backend server
VITE_API_URL=http://localhost:3847

# WebSocket URL for real-time updates
VITE_WS_URL=ws://localhost:3847

# Server port (used by proxy configuration)
VITE_SERVER_PORT=3847

# Feature flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AI_INSIGHTS=true
VITE_ENABLE_REAL_TIME=true

# Desktop Connection Gate (Postman-style)
# Set to 'true' to require desktop app connection in web mode
VITE_REQUIRE_DESKTOP=false
# Desktop HTTPS endpoint for localhost bridge (required when VITE_REQUIRE_DESKTOP=true)
# VITE_DESKTOP_HTTPS_URL=https://localhost:3848

# Supabase Configuration (required for SaaS mode)
# These variables MUST be set in apps/saas-frontend/.env for Vite to inject them at build time.
# Run 'pnpm run sync:env' from the repo root to sync VITE_ vars from root .env.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
