{
  "name": "@designqa/desktop-launcher",
  "version": "2.0.1",
  "description": "DesignQA Local Server Launcher",
  "author": "DesignQA Team",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:workspace-packages && npm run build:frontend && npm run copy:backend && npm run install:backend-deps && npm run install:deps && npm run build:main",
    "build:frontend": "cd ../saas-frontend && pnpm build:electron",
    "build:main": "tsc --project tsconfig.main.json",
    "build:workspace-packages": "cd ../../packages/mcp-client && pnpm run build && cd ../compare-engine && pnpm run build",
    "copy:backend": "node scripts/copy-backend.js",
    "install:backend-deps": "node scripts/install-backend-deps.js",
    "install:deps": "pnpm install --filter @designqa/desktop-launcher",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:all": "electron-builder --mac --win"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.designqa.launcher",
    "productName": "DesignQA Local Server",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      "saas-backend/**/*",
      "!saas-backend/dist/**/*",
      "!saas-backend/tests/**/*",
      "!**/node_modules/**/{README.md,README,readme.md,readme}",
      "!**/node_modules/**/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!**/src/**/*.ts",
      "!**/src/**/*.tsx",
      "!**/packages/**/src/**",
      "!**/packages/**/*.ts",
      "!**/packages/**/*.tsx"
    ],
    "asarUnpack": [
      "saas-backend/src/**/*",
      "saas-backend/node_modules/**/*",
      "saas-backend/packages/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "forceCodeSigning": false
    },
    "directories": {
      "output": "build"
    },
    "extraResources": [
      {
        "from": "saas-backend/node_modules",
        "to": "app.asar.unpacked/saas-backend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "saas-backend/package.json",
        "to": "app.asar.unpacked/saas-backend/package.json"
      }
    ]
  }
}
